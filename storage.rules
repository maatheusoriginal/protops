rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    function validVideo() {
      return request.resource != null
        && request.resource.size < 250 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    match /projects/{projectId}/images/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /projects/{projectId}/videos/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validVideo();
      allow delete: if isAdmin();
    }

    match /cities/{cityId}/images/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

